# Select the upstream API protocol, independently of the provider or model.
LLM_ADAPTER=chat_completions
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MODEL=your-model-id

# Chat APIs vary on the name of their output-token parameter.
LLM_CHAT_TOKEN_FIELD=max_tokens

# Exa is independent of the selected LLM provider.
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_NUM_RESULTS=5

AI_REQUESTS_PER_MINUTE=6
